        <mxCell id="m_state" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&amp;laquo;module&amp;raquo; &lt;b&gt;BoardState&lt;/b&gt;&lt;br&gt;&lt;br&gt;- board, selectedId, connectSourceId&lt;br&gt;- remote {status, lastAction, error}&lt;br&gt;&lt;br&gt;+ snapshot() · toPersistedBoard()&lt;br&gt;+ setBoard(board) · setName(name)&lt;br&gt;+ setRemote(status, lastAction, error)&lt;br&gt;+ select(id) · moveSelected(x, y)&lt;br&gt;+ addRectangle() · addText()&lt;br&gt;+ beginConnect() · completeConnect(targetId)&lt;br&gt;+ removeSelected()&lt;br&gt;+ &lt;b&gt;applyEvent(event)&lt;/b&gt;" vertex="1">
