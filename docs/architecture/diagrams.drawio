          <mxGeometry height="95" width="330" x="1230" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="c_leg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&amp;#8213;&amp;#8213;&amp;gt; asociación / dependencia (import)&lt;br&gt;- - -&amp;#9651; realización (implements)&lt;br&gt;&amp;#9670;&amp;#8213;&amp;#8213; composición (contiene)&lt;br&gt;- - -&amp;gt; lanza / dependencia débil&lt;br&gt;&lt;font color=&quot;#6C8EBF&quot;&gt;&lt;b&gt;- - -&amp;gt;&lt;/b&gt;&lt;/font&gt; HTTP/JSON (no hay import: contrato REST)&lt;br&gt;&lt;font color=&quot;#82B366&quot;&gt;&lt;b&gt;- - -&amp;gt;&lt;/b&gt;&lt;/font&gt; STOMP sobre WebSocket (no hay import: contrato de eventos, docs/event-contract.md)&lt;br&gt;&lt;font color=&quot;#82B366&quot;&gt;&lt;b&gt;Borde verde&lt;/b&gt;&lt;/font&gt; = clase o módulo nuevo del Lab #6 &amp;nbsp;·&amp;nbsp; &lt;b&gt;negrita&lt;/b&gt; = miembro agregado en el Lab #6 a una clase existente&lt;br&gt;&lt;br&gt;BoardView no importa BoardState ni BoardApiClient: recibe snapshots y emite intents por callbacks registrados con on().&lt;br&gt;BoardRealtimeClient no importa BoardEvents: BoardApp construye el sobre y el cliente en tiempo real solo lo serializa y lo envía.&lt;br&gt;/topic/boards/{id} lo atiende el broker simple que habilita WebSocketConfig; BoardWebSocketController publica ahí solo si el evento fue aceptado.&lt;br&gt;No se incluyen ApiError, GlobalExceptionHandler ni los DTO de request: son detalles de transporte HTTP." vertex="1">
          <mxGeometry height="190" width="1000" x="20" y="1360" as="geometry" />
        </mxCell>
